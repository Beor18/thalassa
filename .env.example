# Postgres local (docker run ... ver README). Para Supabase pegá su connection string.
DATABASE_URL=postgres://thalassa:thalassa@localhost:5434/thalassa
# openssl rand -base64 48
SESSION_SECRET=
# Multiplicador de velocidad del juego (1 = ritmo clásico)
GAME_SPEED=10
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
# Programa Anchor desplegado en devnet (onchain/)
NEXT_PUBLIC_THALASSA_PROGRAM_ID=
# Llave de la canilla de SOL de prueba (devnet). solana-keygen new -o keys/faucet.json
FAUCET_KEYPAIR_PATH=keys/faucet.json
SOLANA_WS_URL=wss://api.devnet.solana.com
# URL pública del sitio (canonical, sitemap, imágenes para redes)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Opcional: email de contacto que muestran términos y privacidad
NEXT_PUBLIC_CONTACT_EMAIL=
