{
  "name": "thalassa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker start thalassa-db 2>/dev/null || docker run -d --name thalassa-db --restart unless-stopped -e POSTGRES_USER=thalassa -e POSTGRES_PASSWORD=thalassa -e POSTGRES_DB=thalassa -p 5434:5432 -v thalassa-pg:/var/lib/postgresql/data postgres:17-alpine",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:deploy": "tsx scripts/migrate.mts",
    "vercel-build": "pnpm db:deploy && next build",
    "db:studio": "drizzle-kit studio",
    "dev:session": "tsx --conditions=react-server scripts/dev-session.mts",
    "smoke": "tsx --conditions=react-server scripts/smoke.mts",
    "check:citizen": "tsx --conditions=react-server scripts/check-citizen.mts",
    "check:faucet": "tsx --conditions=react-server scripts/check-faucet.mts",
    "metrics": "tsx --conditions=react-server scripts/metrics.mts"
  },
  "dependencies": {
    "@solana-program/system": "^0.15.0",
    "@solana/kit": "^8.4.0",
    "@solana/react": "^8.4.0",
    "@wallet-standard/react": "^1.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "motion": "^14.1.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "uqr": "0.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.8.1"
}
